{
  "name": "rss-feed",
  "private": true,
  "type": "module",
  "description": "Personal RSS reader on Cloudflare Workers + D1. No runtime dependencies.",
  "scripts": {
    "test": "node --import ./test/helpers/text-imports.js --test",
    "dev": "wrangler dev --test-scheduled",
    "dev:sandbox": "npm run db:migrate:local && wrangler dev --test-scheduled --ip 0.0.0.0 --port 8787",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply rss-feed --remote",
    "preview": "wrangler versions upload",
    "db:migrate:local": "wrangler d1 migrations apply rss-feed --local"
  },
  "devDependencies": {
    "wrangler": "^4.134.0"
  }
}
